<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="MotorControl" Id="{5f648095-34fc-43f9-bd69-7c1632fbad99}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MotorControl
VAR
	motX	:	AXIS_REF;
	motY	:	AXIS_REF;
	motZ	:	AXIS_REF;
	
	inst_NcToPlc_NCI	AT %I*	:	NCTOPLC_NCICHANNEL_REF;
	inst_PlcToNc_NCI	AT %Q*	:	PLCTONC_NCICHANNEL_REF;
	
	fb_JSReference	:	FB_JSReference;
	fb_MotorPower	:	FB_MotorPower;
	fb_MotorReset	:	FB_MotorReset;
	
	fb_McodeMonitor	:	FB_McodeMonitor;
	fb_RParamInit	:	FB_RParamInit;
	fb_Backend		:	FB_BackendManager;
	
	bPowered	:	BOOL;
	bMotorReset	:	BOOL;
	bError		:	BOOL;
	bBusy		:	BOOL;
	
	bOpMcodeMonitor	:	BOOL	:=	FALSE;
	
	nMotorControlState	:	UDINT	:= 0;
	nInterpreterState	:	UDINT	:= 0;
	nErrorState			:	UDINT;
	
	
	fb_BuildGroup	:	CfgBuild3DGroup;
	fb_LoadProgEx	:	ItpLoadProgEx;
	fb_StartStopEx	:	ItpStartStopEx;
	fb_ClearGroup	:	CfgReconfigGroup;
	fb_ResetEx		:	ItpResetEx2;
	
	fb_MCJogX		:	FB_Jog;
	fb_MCJogY		:	FB_Jog;
	fb_MCJogZ		:	FB_Jog;
	
	fb_MoveAbsX		:	MC_MoveAbsolute;
	fb_MoveAbsY		:	MC_MoveAbsolute;
	fb_MoveAbsZ		:	MC_MoveAbsolute;
	
	fb_ExtMessage	:	FB_ExtMessage;
	
	fb_HMITask		:	FB_HMITask;
	
//	nMoveAbsVel		:	REAL	:=	30.0;
	
	fb_MCHaltX		:	MC_Halt;
	fb_MCHaltY		:	MC_Halt;
	fb_MCHaltZ		:	MC_Halt;
	
	fb_ItpEStop		:	ItpEStopEx;
	
	// Axis 4 extension: link motQ1 to NC Axis 4 after PLC Rebuild.
	motQ1 : AXIS_REF;
	fb_Q1Power : MC_Power;
	fb_Q1Reset : MC_Reset;
	fb_Q1Jog : MC_Jog;
	fb_Q1Status : MC_ReadStatus;
	fb_Q1ResetEdge : R_TRIG;
	fb_BuildGroupQ1 : CfgBuildExt3DGroup;
	bQ1UseLatched : BOOL := FALSE;
	bQ1Reserved : BOOL := FALSE; // Conservative lock, cleared only after group removal
	bQ1Linked : BOOL;
	bQ1Enable : BOOL;
	bQ1ManualAllowed : BOOL;
	bQ1Ready : BOOL;
	bQ1BuildStarted : BOOL := FALSE;
	nQ1Interlock : UDINT := 0; // 0=none, 1=start not ready, 2=permission/power/mode lost
	fQ1ActPos : LREAL;
	fQ1ActVelo : LREAL;

END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Axis 4 service. No writes to existing XYZ ready/power/reset signals.
bQ1Linked := motQ1.NcToPlc.AxisId = 4;
fb_Q1Status(Axis := motQ1, Enable := bQ1Linked);
IF UserVar.bESTOP THEN
	UserVar.Q1Enable := FALSE; // No automatic re-enable after ESTOP reset
	UserVar.Q1JogButton := 0;
END_IF
bQ1Enable := bQ1Linked AND UserVar.Q1Commissioned AND UserVar.Q1Enable
	AND NOT UserVar.bESTOP;
fb_Q1Power(Axis := motQ1, Enable := bQ1Enable,
	Enable_Positive := bQ1Enable, Enable_Negative := bQ1Enable, Override := 100.0);
bQ1ManualAllowed := NOT bQ1Reserved AND NOT UserVar.bESTOP
	AND ((nMotorControlState = 0) OR (nMotorControlState = 100));
fb_Q1ResetEdge(CLK := UserVar.Q1Reset);
fb_Q1Reset(Axis := motQ1,
	Execute := fb_Q1ResetEdge.Q AND bQ1Linked AND NOT bQ1Reserved
		AND NOT fb_Q1Jog.Busy AND NOT UserVar.bESTOP
		AND ((nMotorControlState = 0) OR (nMotorControlState = 100)
			OR (nMotorControlState = 200)));
fb_Q1Jog(Axis := motQ1, Mode := E_JogMode.MC_JOGMODE_CONTINOUS,
	Velocity := UserVar.Q1JogVelocity,
	JogForward := bQ1ManualAllowed AND bQ1Enable AND fb_Q1Power.Status
		AND NOT fb_Q1Reset.Busy AND NOT UserVar.Q1Reset
		AND (UserVar.Q1JogVelocity > 0.0) AND (UserVar.Q1JogButton = 1),
	JogBackwards := bQ1ManualAllowed AND bQ1Enable AND fb_Q1Power.Status
		AND NOT fb_Q1Reset.Busy AND NOT UserVar.Q1Reset
		AND (UserVar.Q1JogVelocity > 0.0) AND (UserVar.Q1JogButton = -1));
bQ1Ready := bQ1Enable AND fb_Q1Power.Status AND NOT fb_Q1Power.Error
	AND fb_Q1Status.Valid AND fb_Q1Status.StandStill AND NOT fb_Q1Status.Error
	AND NOT fb_Q1Status.ErrorStop AND NOT fb_Q1Jog.Busy AND NOT fb_Q1Jog.Error
	AND NOT fb_Q1Reset.Busy AND NOT fb_Q1Reset.Error AND NOT UserVar.Q1Reset
	AND (UserVar.Q1JogButton = 0);
fQ1ActPos := motQ1.NcToPlc.ActPos;
fQ1ActVelo := motQ1.NcToPlc.ActVelo;
IF (nMotorControlState = 200) AND NOT bQ1Reserved THEN
	bQ1UseLatched := UserVar.Q1UseInGCode;
	nQ1Interlock := 0;
END_IF
// A participating Q1 fault stops the shared channel; XYZ-only runs are unaffected.
IF bQ1Reserved AND (nMotorControlState >= 202) AND (nMotorControlState <= 261)
	AND (NOT bQ1Enable OR NOT fb_Q1Power.Status OR fb_Q1Power.Error
		OR NOT fb_Q1Status.Valid OR fb_Q1Status.Error OR fb_Q1Status.ErrorStop
		OR (UserVar.OpMode <> 2)) THEN
	nQ1Interlock := 2;
	nErrorState := nMotorControlState;
	bError := TRUE;
	nMotorControlState := 299;
END_IF

CASE nMotorControlState OF

0:
	// Mode Selecting
	IF (UserVar.OpMode = 1) OR (UserVar.OpMode = 2) THEN
		bBusy	:=	TRUE;
		nMotorControlState	:=	1;
	ELSE
		bBusy	:=	FALSE;
		bOpMcodeMonitor		:=	FALSE;
	END_IF

//1:
//	fb_MotorReset(
//		motX	:=	motX,
//		motY	:=	motY,
//		motZ	:=	motZ,
//		bResetX	:=	TRUE,
//		bResetY	:=	TRUE,
//		bResetZ	:=	TRUE,
//		bReset	=>	bMotorReset);
//	IF bMotorReset THEN
////		fb_MotorReset.bResetX	:=	FALSE;
////		fb_MotorReset.bResetY	:=	FALSE;
////		fb_MotorReset.bResetZ	:=	FALSE;
//		nMotorControlState	:= 2;
//	END_IF

1:
	// Initial Power ON
	fb_MotorPower(
		motX	:=	motX,
		motY	:=	motY,
		motZ	:=	motZ,
		bPowerX	:=	TRUE,
		bPowerY	:=	TRUE,
		bPowerZ	:=	TRUE,
		bPowered=>	bPowered);
	IF bPowered THEN
		nMotorControlState	:= 2;
	END_IF

2:
	// Initial Referencing
	fb_JSReference(
		motX	:=	motX,
		motY	:=	motY,
		motZ	:=	motZ,
		bStartX	:=	TRUE,
		bStartY	:=	TRUE,
		bStartZ	:=	TRUE);
	IF fb_JSReference.bReferenced THEN
		fb_JSReference.bStartX	:=	FALSE;
		fb_JSReference.bStartY	:=	FALSE;
		fb_JSReference.bStartZ	:=	FALSE;
		bBusy	:=	FALSE;
		IF UserVar.OpMode = 1 THEN
			nMotorControlState	:= 100;
		ELSIF UserVar.OpMode = 2 THEN
			nMotorControlState	:= 200;
		END_IF
	END_IF

50:
	fb_MotorPower(
		motX	:=	motX,
		motY	:=	motY,
		motZ	:=	motZ,
		bPowerX	:=	FALSE,
		bPowerY	:=	FALSE,
		bPowerZ	:=	FALSE);
	IF NOT fb_MotorPower.bPowerBusy THEN
		bBusy	:=	FALSE;
		nMotorControlState	:=	0;
	END_IF


90:
	UserVar.bRESET	:=	FALSE;
	nMotorControlState	:=	50;
	


99:
	IF UserVar.bRESET THEN
		UserVar.bESTOP	:=	FALSE;
		nMotorControlState	:=	90;
	END_IF
	

100:
	// Jog Mode
	IF 	(UserVar.JogButtonX <> 0) OR
		(UserVar.JogButtonY <> 0) OR
		(UserVar.JogButtonZ <> 0) THEN
		bBusy	:=	TRUE;
		nMotorControlState	:=	110;
	ELSIF UserVar.JogMovePos THEN
		bBusy	:=	TRUE;
		nMotorControlState	:=	120;
	ELSIF 	UserVar.NordsonReadPressureBtn OR
			UserVar.NordsonWritePressureBtn OR 
			UserVar.LJ_S8000CaptureBtn THEN
		bBusy	:=	TRUE;
		nMotorControlState	:=	130;	// HMI Task
	ELSE
		bBusy	:=	FALSE;
	END_IF
	
	IF	(fb_MotorPower.Power_X	<>	UserVar.JogPowerX) OR
		(fb_MotorPower.Power_Y	<>	UserVar.JogPowerY) OR
		(fb_MotorPower.Power_Z	<>	UserVar.JogPowerZ) THEN
		nMotorControlState	:=	101;
		bBusy	:=	TRUE;		
	END_IF
	
	IF UserVar.OpMode <> 1 THEN
		// Turning OFF
		bBusy	:=	TRUE;
		nMotorControlState	:=	50;
	END_IF

101:
	// Power Changed
	fb_MotorPower(
		motX	:=	motX,
		motY	:=	motY,
		motZ	:=	motZ,
		bPowerX	:=	UserVar.JogPowerX,
		bPowerY	:=	UserVar.JogPowerY,
		bPowerZ	:=	UserVar.JogPowerZ);
	IF NOT fb_MotorPower.bPowerBusy THEN
		fb_JSReference(
			motX	:=	motX,
			motY	:=	motY,
			motZ	:=	motZ,
			bStartX	:=	UserVar.JogPowerX,
			bStartY	:=	UserVar.JogPowerY,
			bStartZ	:=	UserVar.JogPowerZ);
		IF (NOT (UserVar.JogPowerX OR UserVar.JogPowerY OR UserVar.JogPowerZ))
			OR fb_JSReference.bReferenced THEN
			bBusy	:=	FALSE;
			nMotorControlState	:= 100;
		END_IF
	END_IF



	
	
110:
	fb_MCJogX(mot	:=	motX,
		JogButton	:=	BOOL_TO_INT(UserVar.JogPowerX) * UserVar.JogButtonX);
	fb_MCJogY(mot	:=	motY,
		JogButton	:=	BOOL_TO_INT(UserVar.JogPowerY) * UserVar.JogButtonY);
	fb_MCJogZ(mot	:=	motZ,
		JogButton	:=	BOOL_TO_INT(UserVar.JogPowerZ) * UserVar.JogButtonZ);

//	IF 
//	END_IF
	IF	(fb_MCJogX.bError OR 
		 fb_MCJogY.bError OR
		 fb_MCJogZ.bError) THEN
		nMotorControlState :=	199;
	ELSIF NOT (fb_MCJogX.bBusy OR
			fb_MCJogY.bBusy OR
			fb_MCJogZ.bBusy) THEN
		nMotorControlState	:=	100;
	END_IF

120:
	IF UserVar.JogPowerX THEN
		fb_MoveAbsX(
			Axis		:=	motX,
			position	:=	STRING_TO_LREAL(UserVar.JogTargX),
			velocity	:=	STRING_TO_LREAL(UserVar.JogTargVel)/60.0,
			Execute		:=	TRUE);
	END_IF
	IF UserVar.JogPowerY THEN
		fb_MoveAbsY(
			Axis		:=	motY,
			position	:=	STRING_TO_LREAL(UserVar.JogTargY),
			velocity	:=	STRING_TO_LREAL(UserVar.JogTargVel)/60.0,
			Execute		:=	TRUE);
	END_IF
	IF UserVar.JogPowerZ THEN
		fb_MoveAbsZ(
			Axis		:=	motZ,
			position	:=	STRING_TO_LREAL(UserVar.JogTargZ),
			velocity	:=	STRING_TO_LREAL(UserVar.JogTargVel)/60.0,
			Execute		:=	TRUE);
	END_IF
	nMotorControlState	:=	121;
	
	

121:
	IF UserVar.JogPowerX THEN
		fb_MoveAbsX(
			Axis		:=	motX,
			position	:=	STRING_TO_LREAL(UserVar.JogTargX),
			velocity	:=	STRING_TO_LREAL(UserVar.JogTargVel)/60.0,
			Execute		:=	FALSE);
	END_IF
	IF UserVar.JogPowerY THEN
		fb_MoveAbsY(
			Axis		:=	motY,
			position	:=	STRING_TO_LREAL(UserVar.JogTargY),
			velocity	:=	STRING_TO_LREAL(UserVar.JogTargVel)/60.0,
			Execute		:=	FALSE);
	END_IF
	IF UserVar.JogPowerZ THEN
		fb_MoveAbsZ(
			Axis		:=	motZ,
			position	:=	STRING_TO_LREAL(UserVar.JogTargZ),
			velocity	:=	STRING_TO_LREAL(UserVar.JogTargVel)/60.0,
			Execute		:=	FALSE);
	END_IF
	
	IF NOT ((UserVar.JogPowerX AND fb_MoveAbsX.Busy) OR
			(UserVar.JogPowerY AND fb_MoveAbsY.Busy) OR
			(UserVar.JogPowerZ AND fb_MoveAbsZ.Busy)) THEN
		UserVar.JogMovePos	:=	FALSE;
		bBusy	:=	FALSE;
		nMotorControlState	:=	100;
	END_IF

	
130:
	IF NOT (UserVar.NordsonReadPressureBtn OR
			UserVar.NordsonWritePressureBtn OR
			UserVar.LJ_S8000CaptureBtn) THEN
		bBusy	:=	FALSE;
		nMotorControlState	:= 100;
	END_IF


190:
	fb_MCHaltX(
		Axis	:=	motX,
		Execute	:=	FALSE);
	fb_MCHaltY(
		Axis	:=	motY,
		Execute	:=	FALSE);
	fb_MCHaltZ(
		Axis	:=	motZ,
		Execute	:=	FALSE);
	
	fb_MoveAbsX(
		Axis		:=	motX,
		Execute		:=	FALSE);
	fb_MoveAbsY(
		Axis		:=	motY,
		Execute		:=	FALSE);
	fb_MoveAbsZ(
		Axis		:=	motZ,
		Execute		:=	FALSE);
	
	nMotorControlState	:=	191;
		
191:	
	fb_MCJogX(mot	:=	motX,
		JogButton	:=	0);
	fb_MCJogY(mot	:=	motY,
		JogButton	:=	0);
	fb_MCJogZ(mot	:=	motZ,
		JogButton	:=	0);
	
	fb_MotorReset(
		motX	:=	motX,
		motY	:=	motY,
		motZ	:=	motZ,
		bResetX	:=	fb_MCJogX.bError,
		bResetY	:=	fb_MCJogY.bError,
		bResetZ	:=	fb_MCJogZ.bError,
		bReset	=>	bMotorReset);
		
	IF bMotorReset THEN
		nMotorControlState	:=	192;
	END_IF
	
	
192:
	fb_MotorReset(
		motX	:=	motX,
		motY	:=	motY,
		motZ	:=	motZ,
		bResetX	:=	FALSE,
		bResetY	:=	FALSE,
		bResetZ	:=	FALSE,
		bReset	=>	bMotorReset);

	nMotorControlState	:=	193;
	
193:
	fb_MCJogX(mot	:=	motX,
		JogButton	:=	0);
	fb_MCJogY(mot	:=	motY,
		JogButton	:=	0);
	fb_MCJogZ(mot	:=	motZ,
		JogButton	:=	0);
	
	UserVar.bRESET	:=	FALSE;
	UserVar.JogMovePos	:=	FALSE;
	nMotorControlState	:=	50;

	
199:
	fb_MCHaltX(
		Axis	:=	motX,
		Execute	:=	TRUE);
	fb_MCHaltY(
		Axis	:=	motY,
		Execute	:=	TRUE);
	fb_MCHaltZ(
		Axis	:=	motZ,
		Execute	:=	TRUE);
	IF (fb_MCHaltX.Done AND
		fb_MCHaltY.Done AND
		fb_MCHaltZ.Done)
		AND UserVar.bRESET THEN// AND bMotorReset THEN
		
		UserVar.bESTOP	:=	FALSE;
		nMotorControlState	:=	190;
	END_IF

	
	
200:
	IF UserVar.SingleGCodeMode THEN
		IF UserVar.SingleGCodeTRG THEN
			UserVar.SingleGCodeTRG	:=	FALSE;
			UserVar.RunningGCodeName	:=	HMIVar.CodeName;
			bBusy	:=	TRUE;
			bOpMcodeMonitor		:=	TRUE;
			nMotorControlState	:=	201;
		END_IF
	ELSE
		IF UserVar.ContinueGCode THEN
			IF f_QueuePop(
					pQueue := ADR(UserVar.GCodeNameQueue),
					str => UserVar.RunningGCodeName) THEN
				HMIVar.GCodeQueueString	:=	f_Queue_ToString(ADR(UserVar.GCodeNameQueue));
				bBusy	:=	TRUE;
				bOpMcodeMonitor		:=	TRUE;
				nMotorControlState	:=	201;
	//		ELSIF UserVar.OpMode <> 2 THEN
	//			// Turning OFF
	//			bBusy	:=	TRUE;
	//			nMotorControlState	:=	50;
			END_IF
	//	ELSIF UserVar.OpMode <> 2 THEN
	//		// Turning OFF
	//		bBusy	:=	TRUE;
	//		nMotorControlState	:=	50;
		END_IF
	END_IF

	IF UserVar.OpMode <> 2 THEN
		// Turning OFF
		bBusy	:=	TRUE;
		nMotorControlState	:=	50;
	END_IF

201:
	IF bQ1UseLatched THEN
		bQ1Reserved := TRUE;
		IF NOT bQ1BuildStarted AND NOT bQ1Ready THEN
			nQ1Interlock := 1;
			nErrorState := 201;
			bError := TRUE;
			nMotorControlState := 299;
		ELSE
	// Initial interpolation group building
	nInterpreterState	:=	ItpGetStateInterpreter(sNciToPlc:=inst_NcToPlc_NCI);
	IF	nInterpreterState = Tc2_NCI.NCI_INTERPRETER_IDLE	THEN	
		bQ1BuildStarted := TRUE;
		fb_BuildGroupQ1(
			bExecute	:= TRUE, 
			nGroupId	:= ItpGetGroupId(sNciToPlc:=inst_NcToPlc_NCI) , 
			nXAxisId	:= motX.NcToPlc.AxisId, 
			nYAxisId	:= motY.NcToPlc.AxisId, 
			nZAxisId	:= motZ.NcToPlc.AxisId,
			nQ1AxisId := motQ1.NcToPlc.AxisId,
			nQ2AxisId := 0, nQ3AxisId := 0, nQ4AxisId := 0, nQ5AxisId := 0);
		IF NOT fb_BuildGroupQ1.bBusy THEN
			IF NOT fb_BuildGroupQ1.bErr THEN
				fb_RParamInit(
					bExecute	:=	TRUE,
					inst_NcToPlc_NCI	:=	inst_NcToPlc_NCI);
				nMotorControlState	:= 202;
			ELSE
				nErrorState	:= nMotorControlState;
				bError	:= TRUE;
				nMotorControlState	:= 299;
			END_IF
			ItpSetOverridePercent(
				fOverridePercent	:=	100.0,
				sPlcToNci	:=	inst_PlcToNc_NCI);
		END_IF
	
	END_IF
		END_IF
	ELSE
	// Initial interpolation group building
	nInterpreterState	:=	ItpGetStateInterpreter(sNciToPlc:=inst_NcToPlc_NCI);
	IF	nInterpreterState = Tc2_NCI.NCI_INTERPRETER_IDLE	THEN	
		fb_BuildGroup(
			bExecute	:= TRUE, 
			nGroupId	:= ItpGetGroupId(sNciToPlc:=inst_NcToPlc_NCI) , 
			nXAxisId	:= motX.NcToPlc.AxisId, 
			nYAxisId	:= motY.NcToPlc.AxisId, 
			nZAxisId	:= motZ.NcToPlc.AxisId);
		IF NOT fb_BuildGroup.bBusy THEN
			IF NOT fb_BuildGroup.bErr THEN
				fb_RParamInit(
					bExecute	:=	TRUE,
					inst_NcToPlc_NCI	:=	inst_NcToPlc_NCI);
				nMotorControlState	:= 202;
			ELSE
				nErrorState	:= nMotorControlState;
				bError	:= TRUE;
				nMotorControlState	:= 299;
			END_IF
			ItpSetOverridePercent(
				fOverridePercent	:=	100.0,
				sPlcToNci	:=	inst_PlcToNc_NCI);
		END_IF
	
	END_IF
	END_IF

202:
	fb_BuildGroupQ1(bExecute := FALSE);
	fb_BuildGroup(	bExecute	:= FALSE	); 
	IF fb_RParamInit.bBusy THEN
		fb_RParamInit(
			bExecute	:=	FALSE,
			inst_NcToPlc_NCI	:=	inst_NcToPlc_NCI);
		nMotorControlState	:= 205;			
	END_IF

205:
	fb_RParamInit(
		bExecute	:=	FALSE,
		inst_NcToPlc_NCI	:=	inst_NcToPlc_NCI);
	IF NOT fb_RParamInit.bBusy THEN
		IF fb_RParamInit.bErr THEN
			nMotorControlState	:=	202;
		ELSE
			nMotorControlState	:=	210;
		END_IF
	END_IF
	

210:
	fb_LoadProgEx(
		sNciToPlc	:=	inst_NcToPlc_NCI,
		bExecute	:=	TRUE,
		sPrg		:=	f_MakeAbsPath(UserVar.RunningGCodeName),
		nLength		:=	INT_TO_UDINT(LEN(f_MakeAbsPath(UserVar.RunningGCodeName))));
	
	IF NOT fb_LoadProgEx.bBusy THEN
		IF NOT fb_LoadProgEx.bErr THEN
			nMotorControlState	:=	211;
		ELSE
			nErrorState	:=	nMotorControlState;
			bError	:=	TRUE;
			nMotorControlState	:=	299;
		END_IF
		fb_LoadProgEx(
			sNciToPlc	:=	inst_NcToPlc_NCI,
			bExecute	:=	FALSE); 
	END_IF
	
	
211:
	fb_StartStopEx(
		bStart	:=	TRUE,
		bStop	:=	FALSE,
		tTimeOut	:= , 
		sNciToPlc	:=	 inst_NcToPlc_NCI);
	
	IF NOT fb_StartStopEx.bBusy THEN
		IF NOT fb_StartStopEx.bErr THEN
			nMotorControlState	:=	212;
		ELSE
			nErrorState	:=	nMotorControlState;
			bError	:=	TRUE;
			nMotorControlState	:=	299;
		END_IF
		fb_StartStopEx(
			bStart	:=	FALSE,
			sNciToPlc	:=	 inst_NcToPlc_NCI); 
	END_IF
	
212:
	nInterpreterState	:= ItpGetStateInterpreter(sNciToPlc:=inst_NcToPlc_NCI);
	IF nInterpreterState <> Tc2_NCI.NCI_INTERPRETER_READY THEN
		// nci is running
		nMotorControlState	:= 213;
	END_IF


213:
	nInterpreterState	:= ItpGetStateInterpreter(sNciToPlc:=inst_NcToPlc_NCI);
	IF	nInterpreterState = Tc2_NCI.NCI_INTERPRETER_READY THEN
		// program has finished
		fb_RParamInit(
			bExecute	:=	TRUE,
			inst_NcToPlc_NCI	:=	inst_NcToPlc_NCI);
		nMotorControlState	:= 230;
	ELSIF 	nInterpreterState = Tc2_NCI.NCI_INTERPRETER_ABORTED 
	OR 		ItpHasError(sNciToPlc:=inst_NcToPlc_NCI)  THEN
		nErrorState	:= nMotorControlState;
		bError	:= TRUE;
		nMotorControlState	:= 299;
	END_IF
	
230:
	IF fb_RParamInit.bBusy THEN
		fb_RParamInit(
			bExecute	:=	FALSE,
			inst_NcToPlc_NCI	:=	inst_NcToPlc_NCI);
		nMotorControlState	:=	231;
	END_IF
	
231:
	fb_RParamInit(
		bExecute	:=	FALSE,
		inst_NcToPlc_NCI	:=	inst_NcToPlc_NCI);
	IF NOT fb_RParamInit.bBusy THEN
		IF fb_RParamInit.bErr THEN
			nMotorControlState	:=	213;
		ELSE
			nMotorControlState	:=	250;
		END_IF
	END_IF
	
250:
	IF (NOT UserVar.SingleGCodeMode) AND UserVar.ContinueGCode THEN
		IF f_QueuePop(
				pQueue := ADR(UserVar.GCodeNameQueue),
				str => UserVar.RunningGCodeName) THEN
			HMIVar.GCodeQueueString	:=	f_Queue_ToString(ADR(UserVar.GCodeNameQueue));
			nMotorControlState	:=	210;
		ELSE
			nMotorControlState	:=	260;
		END_IF
	ELSE
		nMotorControlState	:=	260;
	END_IF
	
260:
	fb_ClearGroup(
		bExecute	:= TRUE, 
		nGroupId	:= ItpGetGroupId(sNciToPlc:=inst_NcToPlc_NCI));

	IF NOT fb_ClearGroup.bBusy THEN
		IF NOT fb_ClearGroup.bErr THEN
			bQ1Reserved := FALSE;
			bQ1BuildStarted := FALSE;
			fb_BuildGroupQ1(bExecute := FALSE);
			nMotorControlState	:= 261;
		ELSE
			(* add error handling *)
			nErrorState	:= nMotorControlState;
			bError	:= TRUE;
			nMotorControlState	:= 299;				
		END_IF
		fb_ClearGroup(bExecute:=FALSE); 
	END_IF

261:
	fb_ResetEx(
		bExecute:= TRUE, 
		tTimeOut:= , 
		sNciToPlc:= inst_NcToPlc_NCI, 
		bBusy=> , 
		bErr=> , 
		nErrId=> );

	IF NOT fb_ResetEx.bBusy THEN
		IF NOT fb_ResetEx.bErr THEN
			bBusy	:=	FALSE;
			bOpMcodeMonitor		:=	FALSE;
			nMotorControlState	:=	200;
		ELSE
			(* add error handling *)
			nErrorState	:= nMotorControlState;
			bError	:= TRUE;
			nMotorControlState	:= 299;
		END_IF
		fb_ResetEx( bExecute:= FALSE, sNciToPlc:= inst_NcToPlc_NCI);
	END_IF

	
290:
	IF ItpIsEStopEx(inst_NcToPlc_NCI) THEN
		fb_ItpEStop(
			sNciToPlc	:=	inst_NcToPlc_NCI,
			bExecute	:=	FALSE);
		nMotorControlState	:=	291;
	END_IF

	
291:
	fb_ResetEx(
		bExecute:= TRUE, 
		sNciToPlc:= inst_NcToPlc_NCI);

	IF NOT fb_ResetEx.bBusy THEN
		IF NOT fb_ResetEx.bErr THEN
			bBusy	:=	FALSE;
			bOpMcodeMonitor		:=	FALSE;
			nMotorControlState	:=	292;
		ELSE
			nErrorState	:= nMotorControlState;
			bError	:= TRUE;
			nMotorControlState	:= 9999;
		END_IF
		fb_ResetEx( bExecute:= FALSE, sNciToPlc:= inst_NcToPlc_NCI);
	END_IF
	

292:
	fb_ClearGroup(
		bExecute	:= TRUE, 
		nGroupId	:= ItpGetGroupId(sNciToPlc:=inst_NcToPlc_NCI));

	IF NOT fb_ClearGroup.bBusy THEN
		IF NOT fb_ClearGroup.bErr THEN
			bQ1Reserved := FALSE;
			bQ1BuildStarted := FALSE;
			fb_BuildGroupQ1(bExecute := FALSE);
			nMotorControlState	:= 50;
		ELSE
			nErrorState	:= nMotorControlState;
			bError	:= TRUE;
			nMotorControlState	:= 9999;				
		END_IF
		fb_ClearGroup(bExecute:=FALSE); 
	END_IF


	
	
299:
	fb_ItpEStop(
		sNciToPlc	:=	inst_NcToPlc_NCI,
		bExecute	:=	TRUE);
	IF UserVar.bRESET THEN
		UserVar.ContinueGCode	:=	FALSE;
		UserVar.bClearQueue	:=	TRUE;
		UserVar.bESTOP	:=	FALSE;
		nMotorControlState	:=	290;
	END_IF

	
9999:
	// No Answer
	bBusy	:=	TRUE;

END_CASE




IF UserVar.bESTOP THEN
	// ESTOP button Triggered	-->	bESTOP: TRUE
	// ESTOP button released	-->	bESTOP: TRUE
	// RESET button Triggered	--> bRESET: TRUE, bESTOP: FALSE
		// 99/199/299 --> 90/190/290 (at eash state)
	// 9-/19-/29- --> 50	: bRESET: FALSE
	bBusy	:=	TRUE;
	CASE UserVar.OpMode OF
		0:
			nMotorControlState	:=	99;
		1:
			nMotorControlState	:=	199;
		2:
			nMotorControlState	:=	299;
	END_CASE
ELSE
	UserVar.bRESET	:=	FALSE;
END_IF






// Q1 reservation owns the NCI stop path even if OpMode was changed.
IF bQ1Reserved AND UserVar.bESTOP THEN
	nMotorControlState := 299;
END_IF

fb_HMITask();
fb_Backend();



(* CASE-INDEPENDENT LOOPS *)
fb_ExtMessage(
	inst_NcToPlc_NCI	:=	inst_NcToPlc_NCI,
	inst_PlcToNc_NCI	:=	inst_PlcToNc_NCI,
	motX	:=	motX,
	motY	:=	motY,
	motZ	:=	motZ,
	bBusy	:=	bBusy);

IF bOpMcodeMonitor	THEN
	fb_McodeMonitor(
		inst_NcToPlc_NCI	:=	inst_NcToPlc_NCI,
		inst_PlcToNc_NCI	:=	inst_PlcToNc_NCI);
END_IF

]]></ST>
