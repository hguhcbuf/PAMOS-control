<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_ReadPressure" Id="{3eedfdbd-e9c2-4df2-be20-e62e60da9873}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ReadPressure
VAR_INPUT
	bExecute	:	BOOL	:=	FALSE;
END_VAR
VAR_OUTPUT
	bBusy		:	BOOL	:=	FALSE;
	bErr		:	BOOL	:=	FALSE;
	Pressure	:	REAL	:=	0.0;
END_VAR
VAR
	nState		:	UDINT	:=	0;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// bNordReadAcc 키면서
// busy state로 올림

// press 읽어서 PYADS에 입력하고
// 다 입력되면 NordPress에 쓰고 bNordReadAcc 끄기
// 만약 실패시 busy 끄면서 fail 올리기



CASE nState OF

0:
	IF bExecute	THEN
		PYADSPort.bNordReadReq	:=	TRUE;
		bBusy	:=	TRUE;
		nState	:=	1;
	END_IF

1:
	IF NOT PYADSPort.bNordReadReq THEN
		IF PYADSPort.bNordReadErr THEN
			PYADSPort.bNordReadErr	:=	FALSE;
			bErr	:=	TRUE;
		ELSE
			bErr	:=	FALSE;
		END_IF
			Pressure:=	PYADSPort.nNordPress;
			bBusy	:=	FALSE;
			nState	:=	0;
	END_IF
END_CASE]]></ST>
    </Implementation>
    <LineIds Name="FB_ReadPressure">
      <LineId Id="41" Count="4" />
      <LineId Id="37" Count="3" />
      <LineId Id="16" Count="4" />
      <LineId Id="22" Count="11" />
      <LineId Id="46" Count="0" />
      <LineId Id="34" Count="2" />
      <LineId Id="9" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>