<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="f_Contains_INT" Id="{2db11fdf-98dc-470d-b74d-fe609e34b0a8}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION f_Contains_INT : BOOL
VAR_INPUT
    num	: INT;
END_VAR
VAR_IN_OUT
	arr : ARRAY[*] OF INT;   // 가변 길이 1D 배열
END_VAR
VAR
    i : DINT;
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[F_Contains_INT := FALSE;

FOR i := LOWER_BOUND(arr, 1) TO UPPER_BOUND(arr, 1) DO
    IF arr[i] = num THEN
        F_Contains_INT := TRUE;
        RETURN;
    END_IF
END_FOR]]></ST>
    </Implementation>
    <LineIds Name="f_Contains_INT">
      <LineId Id="24" Count="6" />
      <LineId Id="7" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>