<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_McodeMonitor" Id="{7428d1d0-8254-4887-90ac-0d2cb3dda97d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_McodeMonitor
VAR_INPUT
END_VAR
VAR_OUTPUT
END_VAR
VAR_IN_OUT
	inst_NcToPlc_NCI	:	NCTOPLC_NCICHANNEL_REF;
	inst_PlcToNc_NCI	:	PLCTONC_NCICHANNEL_REF;
END_VAR
VAR
	bNordsonExtOn		:	BOOL	:=	FALSE;
	bNordsonExtOff		:	BOOL	:=	FALSE;
	bMicrofabExtOn		:	BOOL	:=	FALSE;
	bMicrofabExtOff		:	BOOL	:=	FALSE;
	
	bLJ_S8000TRG		:	BOOL	:=	FALSE;
	nLJ_S8000State		:	UDINT	:=	0;
	
	bNordsonPresWriteTRG:	BOOL	:=	FALSE;	
	nNordsonPresWriteState	:	UDINT	:=	0;
	nNordsonPresRNum	:	INT	:=	0;	
	nNordsonPressRParam	:	LREAL	:=	0.0;
	
	nHskMNum			:	INT	:=	0;
	
	
	bRHskTRG			:	BOOL	:=	FALSE;
	nRHskState			:	UDINT	:=	0;
	nRHskBusyIdx			:	DINT	:=	0;
	nRHskVal			:	LREAL	:=	0;
	
	fb_ConfirmHsk		:	ItpConfirmHsk;
	fb_ReadRParams		:	ItpReadRParams;
	
	fb_LJ_S8000Cap		:	FB_LJ_S8000Capture;
	fb_WritePressure	:	FB_WritePressure;
	
	fb_MicroFabInterval	:	FB_PulseInterval;
	
	nMicroFabIntRNum	:	INT	:=	0;
	nMicroFabInterval	:	LREAL	:=	0.0;
	bMicroFabIntWriteTRG:	BOOL	:=	FALSE;
	nMicroFabIntWriteState	:	UDINT	:=	0;
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[bNordsonExtOn	:=	ItpIsFastMFunc(	
	nFastMFuncNo	:=	MFuncs.M_NordsonExtOn,
	sNciToPlc		:=	inst_NcToPlc_NCI);

bNordsonExtOff	:=	ItpIsFastMFunc(
	nFastMFuncNo	:=	MFuncs.M_NordsonExtOff,
	sNciToPlc		:=	inst_NcToPlc_NCI);

bMicrofabExtOn	:=	ItpIsFastMFunc(
	nFastMFuncNo	:=	MFuncs.M_MicrofabExtOn,
	sNciToPlc		:=	inst_NcToPlc_NCI);

bMicrofabExtOff	:=	ItpIsFastMFunc(
	nFastMFuncNo	:=	MFuncs.M_MicrofabExtOff,
	sNciToPlc		:=	inst_NcToPlc_NCI);

	

IF ItpIsHskMFunc(inst_NcToPlc_NCI) THEN
	nHskMNum	:=	ItpGetHskMFunc(inst_NcToPlc_NCI);
	IF f_Contains_INT(
		num	:=	nHskMNum,
		arr	:=	UserVar.R_Params) THEN
		IF (nHskMNum >= 100) AND (nHskMNum < 110) THEN
			nNordsonPresRNum		:=	nHskMNum;
			bNordsonPresWriteTRG	:=	TRUE;
		ELSIF (nHskMNum >= 110) AND (nHskMNum <= 112) THEN
			nMicroFabIntRNum		:=	nHskMNum;
			bMicroFabIntWriteTRG	:=	TRUE;
		END_IF
	ELSE
		CASE nHskMNum OF
			MFuncs.M_LJ_S8000TRG:
				bLJ_S8000TRG	:=	TRUE;
			MFuncs.M_RHskTRG:
				bRHskTRG	:=	TRUE;
		END_CASE
	END_IF
	
END_IF






IF bNordsonExtOn THEN
	ExtPort.EL2634_OUT[0] := TRUE;
ELSIF bNordsonExtOff THEN
	ExtPort.EL2634_OUT[0] := FALSE;
END_IF


IF bMicrofabExtOn THEN
	IF (nMicroFabInterval - 20) > -0.01 THEN
		fb_MicroFabInterval(
			bOn	:=	TRUE,
			nInterval	:=	TO_UDINT(nMicroFabInterval));
	ELSE
		fb_MicroFabInterval(
			bOn	:=	TRUE);
	END_IF
ELSIF bMicrofabExtOff THEN
	fb_MicroFabInterval(
		bOn	:=	FALSE);
END_IF
fb_MicroFabInterval();





IF bLJ_S8000TRG THEN
	CASE nLJ_S8000State	OF
		0:
			fb_LJ_S8000Cap(	bExecute	:=	TRUE);
			IF fb_LJ_S8000Cap.bBusy	THEN
				fb_LJ_S8000Cap.bExecute	:=	FALSE;
				nLJ_S8000State	:=	1;
			END_IF
		1:
			fb_LJ_S8000Cap(	bExecute	:=	FALSE);
			IF NOT fb_LJ_S8000Cap.bBusy THEN
				fb_ConfirmHsk(
					bExecute	:=	TRUE,
					sNciToPlc	:=	inst_NcToPlc_NCI,
					sPlcToNci	:=	inst_PlcToNc_NCI,);
				nLJ_S8000State	:=	2;
			END_IF
		2:
			IF 	fb_ConfirmHsk.bBusy THEN
				fb_ConfirmHsk(
					bExecute	:=	FALSE,
					sNciToPlc	:=	inst_NcToPlc_NCI,
					sPlcToNci	:=	inst_PlcToNc_NCI,);
				bLJ_S8000TRG	:=	FALSE;
				nLJ_S8000State	:=	0;
			END_IF
	END_CASE
END_IF



IF bNordsonPresWriteTRG THEN
	CASE nNordsonPresWriteState	OF
		0:
			fb_ReadRParams(
				bExecute	:=	TRUE,
				nChnId		:=	inst_NcToPlc_NCI.ChnId,
				pAddr		:=	ADR(nNordsonPressRParam),
				nIndex		:=	nNordsonPresRNum,
				nCount		:=	1);
			nNordsonPresWriteState	:=	1;
		1:
			IF fb_ReadRParams.bBusy THEN
				fb_ReadRParams(
					bExecute	:=	FALSE,
					nChnId		:=	inst_NcToPlc_NCI.ChnId,
					pAddr		:=	ADR(nNordsonPressRParam),
					nIndex		:=	nNordsonPresRNum,
					nCount		:=	1);
				fb_WritePressure(
					bExecute	:=	TRUE,
					Pressure	:=	LREAL_TO_REAL(nNordsonPressRParam));
				IF fb_WritePressure.bBusy	THEN
					nNordsonPresRNum	:=	0;
					fb_WritePressure.bExecute	:=	FALSE;
					nNordsonPresWriteState	:=	2;
				END_IF
			END_IF
		2:
			fb_WritePressure(	bExecute	:=	FALSE);
			IF NOT fb_WritePressure.bBusy THEN
				IF NOT fb_WritePressure.bErr THEN
					fb_ConfirmHsk(
						bExecute	:=	TRUE,
						sNciToPlc	:=	inst_NcToPlc_NCI,
						sPlcToNci	:=	inst_PlcToNc_NCI,);
					nNordsonPresWriteState	:=	3;
				ELSE
					nNordsonPresWriteState	:=	1;
				END_IF
			END_IF
		3:
			IF 	fb_ConfirmHsk.bBusy THEN
				fb_ConfirmHsk(
					bExecute	:=	FALSE,
					sNciToPlc	:=	inst_NcToPlc_NCI,
					sPlcToNci	:=	inst_PlcToNc_NCI,);
				bNordsonPresWriteTRG	:=	FALSE;
				nNordsonPresWriteState	:=	0;
			END_IF
	END_CASE
END_IF



IF bMicroFabIntWriteTRG THEN
	CASE nMicroFabIntWriteState	OF
		0:
			fb_ReadRParams(
				bExecute	:=	TRUE,
				nChnId		:=	inst_NcToPlc_NCI.ChnId,
				pAddr		:=	ADR(nMicroFabInterval),
				nIndex		:=	nMicroFabIntRNum,
				nCount		:=	1);
			nMicroFabIntWriteState	:=	1;
		1:
			IF fb_ReadRParams.bBusy THEN
				fb_ReadRParams(
					bExecute	:=	FALSE,
					nChnId		:=	inst_NcToPlc_NCI.ChnId,
					pAddr		:=	ADR(nMicroFabInterval),
					nIndex		:=	nMicroFabIntRNum,
					nCount		:=	1);
				fb_ConfirmHsk(
					bExecute	:=	TRUE,
					sNciToPlc	:=	inst_NcToPlc_NCI,
					sPlcToNci	:=	inst_PlcToNc_NCI,);
				nMicroFabIntWriteState	:=	2;
			END_IF
		2:
			IF 	fb_ConfirmHsk.bBusy THEN
				fb_ConfirmHsk(
					bExecute	:=	FALSE,
					sNciToPlc	:=	inst_NcToPlc_NCI,
					sPlcToNci	:=	inst_PlcToNc_NCI,);
				bMicroFabIntWriteTRG	:=	FALSE;
				nMicroFabIntWriteState	:=	0;
			END_IF
	END_CASE
END_IF




IF bRHskTRG THEN
	CASE nRHskState	OF
		0:
			nRHskBusyIdx	:=	0;
			nRHskState	:=	1;
		1:
			fb_ReadRParams(
				bExecute	:=	TRUE,
				nChnId		:=	inst_NcToPlc_NCI.ChnId,
				pAddr		:=	ADR(nRHskVal),
				nIndex		:=	TO_DINT(UserVar.R_Params[nRHskBusyIdx]),
				nCount		:=	1);
			nRHskState	:=	2;
		2:
			IF fb_ReadRParams.bBusy THEN
				fb_ReadRParams(
					bExecute	:=	FALSE,
					nChnId		:=	inst_NcToPlc_NCI.ChnId,
					pAddr		:=	ADR(nRHskVal),
					nIndex		:=	TO_DINT(UserVar.R_Params[nRHskBusyIdx]),
					nCount		:=	1);
				IF nRHskVal	<>	UserVar.R_InitVal THEN
					fb_ConfirmHsk(
						bExecute	:=	TRUE,
						sNciToPlc	:=	inst_NcToPlc_NCI,
						sPlcToNci	:=	inst_PlcToNc_NCI,);
					nRHskState	:=	3;
				ELSE
					nRHskBusyIdx	:=	nRHskBusyIdx	+	1;
					IF nRHskBusyIdx >=	(SIZEOF(UserVar.R_Params) / 2) THEN
						nRHskState	:=	0;
					ELSE
						nRHskState	:=	1;
					END_IF
				END_IF
			END_IF
		3:
			IF 	fb_ConfirmHsk.bBusy THEN
				fb_ConfirmHsk(
					bExecute	:=	FALSE,
					sNciToPlc	:=	inst_NcToPlc_NCI,
					sPlcToNci	:=	inst_PlcToNc_NCI,);
				bRHskTRG	:=	FALSE;
				nRHskState	:=	0;
			END_IF
	END_CASE
END_IF







]]></ST>
    </Implementation>
