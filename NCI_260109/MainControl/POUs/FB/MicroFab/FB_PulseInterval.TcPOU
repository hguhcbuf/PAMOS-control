<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_PulseInterval" Id="{4917a029-025d-49c7-9ed5-6eeef52e908a}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PulseInterval
VAR_INPUT
	bOn			:	BOOL	:=	FALSE;
	nInterval	:	UDINT	:=	100;		// (Rising edge ~ Rising edge, [ms]) Must be multiple of 20
END_VAR
VAR_OUTPUT
END_VAR
VAR
	nClk		:	UDINT	:=	0;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF	bOn	THEN
	IF nClk	= 0	THEN
		ExtPort.EL2124_OUT[0]	:=	NOT ExtPort.EL2124_OUT[0];
	END_IF
	IF nClk < TO_UDINT(nInterval / (2 * 10)) THEN
		nClk	:=	nClk + 1;
	ELSE		
		nClk	:=	0;
	END_IF
ELSE
	nClk	:=	0;
	ExtPort.EL2124_OUT[0]	:=	FALSE;
END_IF]]></ST>
    </Implementation>
    <LineIds Name="FB_PulseInterval">
      <LineId Id="9" Count="0" />
      <LineId Id="26" Count="0" />
      <LineId Id="22" Count="0" />
      <LineId Id="27" Count="2" />
      <LineId Id="33" Count="0" />
      <LineId Id="32" Count="0" />
      <LineId Id="30" Count="0" />
      <LineId Id="19" Count="0" />
      <LineId Id="25" Count="0" />
      <LineId Id="21" Count="0" />
      <LineId Id="20" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>