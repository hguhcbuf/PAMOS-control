<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="f_QueuePush" Id="{53f26003-43c5-413e-b921-966d0981ac16}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION f_QueuePush : BOOL
VAR_INPUT
    str : STRING(255);
    pQueue : POINTER TO T_StringQueue;
END_VAR
VAR
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF pQueue^.Count >= 20 THEN
    f_QueuePush := FALSE; // Full
ELSE
    pQueue^.Buffer[pQueue^.Tail] := str;
    pQueue^.Tail := (pQueue^.Tail + 1) MOD 20;
    pQueue^.Count := pQueue^.Count + 1;
    f_QueuePush := TRUE;
END_IF]]></ST>
    </Implementation>
    <LineIds Name="f_QueuePush">
      <LineId Id="22" Count="6" />
      <LineId Id="7" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>