<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.15">
  <POU Name="FB_WritePressure" Id="{b4fb90ea-51b4-44dd-b4a6-820626a76339}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_WritePressure
VAR_INPUT
	bExecute	:	BOOL	:=	FALSE;
	Pressure	:	REAL	:=	0.0;
END_VAR
VAR_OUTPUT
	bBusy		:	BOOL	:=	FALSE;
	bErr		:	BOOL	:=	FALSE;
END_VAR
VAR
	nState		:	UDINT	:=	0;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// bNordWriteAcc 키면서 Press 값 넣고
// busy state로 올림

// PYADS에서 press 를 읽어서 입력하고
// 만약 실패시 busy 끄면서 fail 올리고
// 다 입력되면 bNordWriteAcc 끄기


CASE nState OF

0:
	IF bExecute	THEN
		PYADSPort.bNordWriteReq	:=	TRUE;
		PYADSPort.nNordPress	:=	Pressure;
		bBusy	:=	TRUE;
		nState	:=	1;
	END_IF

1:
	IF NOT PYADSPort.bNordWriteReq THEN
		IF PYADSPort.bNordWriteErr THEN
			PYADSPort.bNordWriteErr	:=	FALSE;
			PYADSPort.nNordPress	:=	0.0;
			bErr	:=	TRUE;
		ELSE
			bErr	:=	FALSE;
		END_IF
			bBusy	:=	FALSE;
			nState	:=	0;		
	END_IF
END_CASE]]></ST>
    </Implementation>
    <LineIds Name="FB_WritePressure">
